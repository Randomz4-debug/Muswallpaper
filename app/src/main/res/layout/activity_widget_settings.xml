<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B0910" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/widgetBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹  Widget" android:textColor="#FFFFFF" android:textSize="28sp" android:padding="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Widget" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Customize content, controls, transparency, colors, sizes and layout. Changes are saved immediately." android:textColor="#AAA6B5" android:textSize="14sp" android:layout_marginTop="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONTENT" android:textColor="#A78BFA" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="24dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#17131F" android:padding="8dp" android:layout_marginTop="8dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Album artwork" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetArtworkSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Song title" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetTitleSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Artist" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetArtistSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Playback controls" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetControlsSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Progress indicator" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetProgressSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Custom text" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetCustomSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Status/time label" android:textColor="#FFFFFF" android:textSize="15sp"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/widgetTimeSwitch" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="APPEARANCE" android:textColor="#A78BFA" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="24dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transparency" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="8dp"/><SeekBar android:id="@+id/widgetOpacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Title size" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetTitleSize" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Artist size" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetArtistSize" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Custom text size" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetCustomSize" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Artwork size" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetArtworkSize" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Widget corner radius" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetCornerRadius" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Widget padding" android:textColor="#FFFFFF" android:textSize="15sp"/><SeekBar android:id="@+id/widgetPadding" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="30"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Layout" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="8dp"/>
<TextView android:id="@+id/widgetLayoutChoice" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:text="Horizontal" android:textColor="#FFFFFF" android:paddingStart="12dp" android:background="#17131F"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEXT &amp; COLORS" android:textColor="#A78BFA" android:textSize="13sp" android:textStyle="bold" android:layout_marginTop="24dp"/>
<EditText android:id="@+id/widgetCustomText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Custom text" android:textColor="#FFFFFF"/>
<EditText android:id="@+id/widgetEmptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Text when no music is playing" android:textColor="#FFFFFF"/>
<EditText android:id="@+id/widgetTimeLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Time/status label" android:textColor="#FFFFFF"/>
<EditText android:id="@+id/widgetTextColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="#FFFFFF — title/custom text" android:textColor="#FFFFFF"/>
<EditText android:id="@+id/widgetSecondaryColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="#C7C7D0 — artist/secondary" android:textColor="#FFFFFF"/>
<EditText android:id="@+id/widgetBackgroundColor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="#17151F — background" android:textColor="#FFFFFF"/>
<TextView android:id="@+id/widgetSave" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center" android:text="SAVE WIDGET" android:textColor="#FFFFFF" android:textStyle="bold" android:background="#7C5CFF" android:layout_marginTop="20dp" android:layout_marginBottom="30dp"/>
</LinearLayout></ScrollView>
