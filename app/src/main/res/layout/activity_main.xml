<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAF3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MusWall"
                android:textColor="#20241E"
                android:textSize="32sp" />
            <TextView
                android:id="@+id/btnPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="💎"
                android:textSize="21sp" />
            <TextView
                android:id="@+id/btnShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="↗"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="⋮"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn your music into beautiful wallpapers."
            android:textColor="#62685F"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#EDF1E8"
            app:cardCornerRadius="24dp"
            app:strokeColor="#E0E6DA"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:text="LOCK SCREEN" android:textSize="11sp" android:textColor="#5E655A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/imageLockPreview"
                            android:layout_width="145dp"
                            android:layout_height="275dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/bg_album_placeholder"
                            android:scaleType="centerCrop" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:text="HOME SCREEN" android:textSize="11sp" android:textColor="#5E655A" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        <ImageView
                            android:id="@+id/imageHomePreview"
                            android:layout_width="145dp"
                            android:layout_height="275dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/bg_album_placeholder"
                            android:scaleType="centerCrop" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Music" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:orientation="vertical">
                        <TextView android:id="@+id/textTrack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No music detected" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/textArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enable music detection below" android:textSize="12sp" android:textColor="#777D74" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <TextView android:id="@+id/textServiceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Not active" android:textSize="11sp" android:textColor="#4B7048" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="#EDF1E8" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Wallpaper Mode" android:textSize="18sp" android:textColor="#20241E" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeMusic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♫  Music"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeStatic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="▧  Static"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/textModeDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Music mode: wallpaper follows the currently playing track." android:textSize="12sp" android:textColor="#656C62"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="#EDF1E8" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:text="Wallpapers" android:textSize="18sp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddImage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ Add" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="8dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/galleryContainer" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
                        <ImageView android:id="@+id/galleryPlaceholder" android:layout_width="82dp" android:layout_height="82dp" android:background="#D7DCD3" android:src="@android:drawable/ic_input_add" android:padding="22dp"/>
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="#EDF1E8" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Wallpaper effect" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/effectGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/effectBlur" android:text="Blur" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/effectCover" android:text="Cover" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/effectCd" android:text="CD 💎" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/effectSquare" android:text="Square 💎" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/effectCoverColor" android:text="Cover Color" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
                <TextView android:text="Blur type" android:textSize="15sp" android:layout_marginTop="7dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/blurGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/blurGaussian" android:text="Gaussian" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/blurSolid" android:text="Solid 💎" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/blurMotion" android:text="Motion 💎" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                        <com.google.android.material.chip.Chip android:id="@+id/blurGlass" android:text="Glass 💎" style="@style/Widget.MaterialComponents.Chip.Choice"/>
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <TextView android:id="@+id/labelBlur" android:text="Blur   80" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderBlur" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1"/>
                <TextView android:id="@+id/labelCoverHeight" android:text="Cover Height   44" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderCoverHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1"/>
                <TextView android:id="@+id/labelCoverOffset" android:text="Cover Offset   50" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderCoverOffset" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1"/>
                <TextView android:id="@+id/labelTransition" android:text="Transition height   20" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderTransition" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1"/>
                <TextView android:id="@+id/labelDarkness" android:text="Darken   0" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderDarkness" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1"/>
                <TextView android:id="@+id/labelScale" android:text="Cover Scale   72" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.slider.Slider android:id="@+id/sliderArtScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="20" android:valueTo="100" android:stepSize="1"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPermission"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            app:cardBackgroundColor="#EDF1E8" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:text="Music Wallpaper Service" android:textSize="18sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/textPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Notification access is required to detect music." android:textSize="13sp" android:textColor="#656C62"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantPermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Grant notification access"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLiveWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Use Live Wallpaper"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenAutostart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Autostart Settings" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenBatterySaver" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Open Battery Settings" style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAutoWallpaper" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Automatic music wallpaper" android:textSize="16sp"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRestoreOnPause" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Restore wallpaper when music pauses" android:textSize="16sp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="14dp" android:text="▧  Apply wallpaper" android:textSize="17sp" app:cornerRadius="30dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="MusWall • fast renderer • real Android live wallpaper" android:textSize="11sp" android:textColor="#777D74"/>
    </LinearLayout>
</ScrollView>
