<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8F3"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="36dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/textTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MusWall" android:textColor="#1C211B" android:textSize="32sp" />
            <TextView android:id="@+id/btnPro" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="9dp" android:text="◆" android:textColor="#7C00FF" android:textSize="20sp" />
            <TextView android:id="@+id/btnShare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="9dp" android:text="↗" android:textColor="#30352F" android:textSize="23sp" />
            <TextView android:id="@+id/btnMenu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="9dp" android:text="⋮" android:textColor="#30352F" android:textSize="26sp" />
        </LinearLayout>
        <TextView android:id="@+id/textSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Turn your music into beautiful wallpapers." android:textColor="#62685F" android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="24dp" app:strokeColor="#DCE2D7" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCK SCREEN" android:textColor="#5F675B" android:textSize="11sp" />
                        <ImageView android:id="@+id/imageLockPreview" android:layout_width="145dp" android:layout_height="275dp" android:layout_marginTop="7dp" android:background="@drawable/bg_album_placeholder" android:contentDescription="Lock screen wallpaper preview" android:scaleType="centerCrop" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME SCREEN" android:textColor="#5F675B" android:textSize="11sp" />
                        <ImageView android:id="@+id/imageHomePreview" android:layout_width="145dp" android:layout_height="275dp" android:layout_marginTop="7dp" android:background="@drawable/bg_album_placeholder" android:contentDescription="Home screen wallpaper preview" android:scaleType="centerCrop" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:contentDescription="Playback" android:src="@android:drawable/ic_media_play" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:orientation="vertical">
                        <TextView android:id="@+id/textTrack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No music detected" android:textColor="#20241E" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
                        <TextView android:id="@+id/textArtist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enable music detection below" android:textColor="#777D74" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>
                    <TextView android:id="@+id/textServiceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready" android:textColor="#4B7048" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wallpaper Mode" android:textColor="#20241E" android:textSize="19sp" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" app:singleSelection="true" app:selectionRequired="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeMusic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="♫  MUSIC" android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeStatic" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▧  STATIC" android:textSize="14sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:id="@+id/textModeDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Music mode uses the MusWall live wallpaper and follows the current track." android:textColor="#656C62" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Wallpapers" android:textColor="#20241E" android:textSize="19sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnAddImage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ ADD" style="@style/Widget.MaterialComponents.Button.TextButton" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="94dp" android:layout_marginTop="6dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/galleryContainer" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView android:id="@+id/galleryPlaceholder" android:layout_width="78dp" android:layout_height="78dp" android:background="#D9DED5" android:contentDescription="Add wallpaper" android:padding="21dp" android:src="@android:drawable/ic_input_add" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wallpaper Effect" android:textColor="#20241E" android:textSize="19sp" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/effectGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/effectBlur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Blur" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/effectCover" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cover" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/effectCd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CD" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/effectSquare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Square" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/effectCoverColor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cover Color" style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Blur type" android:textColor="#4B5349" android:textSize="14sp" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup android:id="@+id/blurGroup" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:id="@+id/blurGaussian" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gaussian" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/blurSolid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Solid" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/blurMotion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Motion" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:id="@+id/blurGlass" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glass" style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
                <TextView android:id="@+id/labelBlur" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Blur   80" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderBlur" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1" />
                <TextView android:id="@+id/labelCoverHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cover Height   44" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCoverHeight" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1" />
                <TextView android:id="@+id/labelCoverOffset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cover Offset   50" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCoverOffset" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1" />
                <TextView android:id="@+id/labelTransition" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transition height   20" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderTransition" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1" />
                <TextView android:id="@+id/labelDarkness" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Darken   0" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderDarkness" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="100" android:stepSize="1" />
                <TextView android:id="@+id/labelScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cover Scale   72" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderArtScale" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="20" android:valueTo="100" android:stepSize="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automatic wallpaper" android:textColor="#20241E" android:textSize="19sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Automatic music wallpaper\nUse live wallpaper when music changes" android:textColor="#20241E" android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchAutoWallpaper" android:layout_width="wrap_content" android:layout_height="wrap_content" android:showText="false" android:textOn="" android:textOff="" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Restore wallpaper when music pauses\nShow the selected original Home/Lock wallpaper" android:textColor="#20241E" android:textSize="15sp" />
                    <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchRestoreOnPause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:showText="false" android:textOn="" android:textOff="" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/cardPermission" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" app:cardBackgroundColor="#EEF2E9" app:cardCornerRadius="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Music Wallpaper Service" android:textColor="#20241E" android:textSize="19sp" />
                <TextView android:id="@+id/textPermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Notification access is required to detect music." android:textColor="#656C62" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnGrantPermission" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Grant notification access" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLiveWallpaper" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Use Live Wallpaper" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenAutostart" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Open Xiaomi Autostart" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenBatterySaver" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:text="Battery: No restrictions" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnApply" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="15dp" android:text="✓  APPLY" android:textSize="16sp" app:cornerRadius="28dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Music mode updates the installed live wallpaper — it does not replace the system wallpaper." android:textColor="#6A7167" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
